      { "location": "San Francisco, CA", "country": "USA" },
      { "location": "Remote",            "country": "USA" }
    ],
    "ziprecruiter": [
      { "location": "San Francisco, CA", "country": "USA" },
      { "location": "Remote",            "country": "USA" }
    ],
