{
  "_README": "ONE config file drives the whole tracker (scraper + dashboard). Edit it by hand, or generate it from your CV using docs/cv-to-config-prompt.md. After editing, commit it and re-run the workflows. All matching is case-insensitive substring on the JOB TITLE unless noted.",

  "profile": {
    "title": "ML / AI Engineer Job Tracker",
    "subtitle": "SF Bay Area · Remote (US)",
    "emoji": "🤖"
  },

  "keywords": {
    "_comment": "A job TITLE is kept if it contains any of these. Use full words; multi-word phrases match as substrings.",
    "include": [
      "machine learning engineer", "ml engineer", "machine learning", "ml platform",
      "machine learning platform", "ml infrastructure", "machine learning infrastructure", "mlops",
      "applied machine learning", "applied ai", "applied ml", "ai engineer",
      "artificial intelligence engineer", "senior ai", "generative ai", "genai", "gen ai",
      "llm engineer", "large language model", "foundation model", "forward deployed",
      "forward-deployed", "applied scientist", "machine learning scientist", "ml scientist",
      "research scientist", "research engineer", "ai research", "deep learning engineer",
      "nlp engineer", "computer vision engineer", "ai infrastructure", "ai platform engineer",
      "ai solutions engineer", "ai product engineer", "recommendation systems engineer",
      "ai scientist", "senior machine learning", "staff machine learning", "principal machine learning"
    ],
    "_exclude_comment": "Titles containing any of these are dropped (junior, off-field, and people-management roles — IC-only per user preference).",
    "exclude": [
      "intern", "internship", "co-op", "coop", "trainee", "apprentice", "new grad", "newgrad",
      "graduate program", "entry level", "entry-level", "junior", "jr.", "jr ",
      "postdoc", "postdoctoral", "phd student", "research assistant", "teaching assistant",
      "volunteer", "unpaid",
      "data entry", "data-entry", "data analyst", "business analyst", "bi analyst",
      "reporting analyst", "analytics analyst",
      "qa engineer", "qa analyst", "qa specialist", "qa lead", "qa manager",
      "quality assurance", "sdet", "test engineer", "test automation",
      "sales", "account executive", "business development", "pre-sales", "presales",
      "customer success", "solutions consultant",
      "frontend", "front-end", "front end", "ui engineer", "ui developer", "web developer",
      "recruiter", "talent acquisition", "staffing",
      "manager", "director", "head of", "vice president", "vp ", "vp,", "chief ", "cto"
    ],
    "_fuzzy_comment": "Optional fuzzy pre-filter for LinkedIn title matching. When both fuzzy_seniority and fuzzy_domain are non-empty, role_is_relevant() uses these instead of the exact-phrase keywords.include filter. Catches title variants like 'Director, Engineering' when searching for 'Engineering Director'. Leave all three empty to use keyword-only matching.",
    "fuzzy_seniority": [],
    "fuzzy_domain": [],
    "fuzzy_exclude": []
  },

