      { "location": "San Francisco Bay Area", "country": "USA" },
      { "location": "Remote",                 "country": "USA" }
    ],
    "hiring_cafe": [
      { "location": "United States" }
    ],
    "_linkedin_partitions_comment": "Optional. Used by --linkedin-emit-matrix / --linkedin-backfill-partition for parallel backfill. Each state gets one matrix worker per search term. High-volume states can be day-sliced to work around LinkedIn's ~1000 result/query cap. Leave empty to use single-run backfill (--linkedin-backfill).",
    "linkedin_partitions": {
      "states": [],
      "high_volume": {
        "locations": [],
        "day_slices": true
      }
    }
  },

